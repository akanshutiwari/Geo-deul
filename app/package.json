{
  "name": "geo-duels-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "sync-idl": "cp -f ../target/idl/geo_duels.json src/idl/ 2>/dev/null; cp -f ../target/types/geo_duels.ts src/idl/ 2>/dev/null; true",
    "dev": "yarn sync-idl && vite --host",
    "build": "yarn sync-idl && tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "e2e": "tsx scripts/e2e.ts"
  },
  "dependencies": {
    "@coral-xyz/anchor": "0.32.1",
    "@magicblock-labs/ephemeral-rollups-sdk": "0.14.3",
    "@solana/wallet-adapter-base": "^0.9.27",
    "@solana/wallet-adapter-react": "^0.15.39",
    "@solana/wallet-adapter-react-ui": "^0.9.39",
    "@solana/web3.js": "^1.98.0",
    "bn.js": "^5.2.1",
    "buffer": "^6.0.3",
    "d3-geo": "^3.1.1",
    "leaflet": "^1.9.4",
    "qrcode.react": "^4.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "topojson-client": "^3.1.0",
    "tweetnacl": "^1.0.3",
    "world-atlas": "2"
  },
  "devDependencies": {
    "@types/bn.js": "^5.1.6",
    "@types/d3-geo": "^3.1.1",
    "@types/leaflet": "^1.9.12",
    "@types/node": "^22.10.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/topojson-client": "^3.1.5",
    "@vitejs/plugin-react": "^4.3.4",
    "tsx": "^4.19.2",
    "typescript": "~5.8.3",
    "vite": "^6.3.5"
  },
  "license": "MIT"
}
